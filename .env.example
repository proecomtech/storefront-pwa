# Copy to .env and fill in. Never commit .env.
# In production these are set as env vars on the host, not read from a file —
# see deploy/env/storefront-pwa-live.env.example.

PORT=3007
NODE_ENV=production

# client_id / client secret from the Partner dashboard.
# SHOPIFY_API_SECRET is required: it verifies the App Bridge session tokens
# that authorise every settings write. Without it the admin is read-only.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Where per-shop settings, uploaded icons and derived renders are written.
# Must be writable and must survive a redeploy, so keep it out of /opt.
DATA_DIR=/var/lib/gaapps/storefront-pwa-live

# The storefront subpath the app proxy is mounted at, as configured in the
# Partner dashboard. Storefront requests carry it themselves, so this is only
# read by the admin's report and setup checks — they run from an iframe on
# admin.shopify.com and have no way to ask. Leave it unless you changed the
# subpath, in which case the checks would otherwise report a missing manifest.
PWA_PROXY_BASE=/apps/pwa

# ---------------------------------------------------------------- billing
# Billing is Shopify App Pricing: the three plans are defined in the Partner
# dashboard, Shopify hosts the checkout, and this app creates no charges and
# needs no Admin API scopes. What it needs is the handles, so a subscription
# can be matched to an entitlement.

# The app handle, as it appears in the Shopify App Pricing URL. Must match
# `handle` in shopify.app.toml, or the Upgrade buttons 404.
PWA_APP_HANDLE=proecomtech-storefront-pwa

# The plan handles exactly as typed into the Partner dashboard. Get one wrong
# and a paying merchant matches no plan — which resolves to the paid tier, not
# to free, so the failure costs a little revenue rather than locking a paying
# merchant out. Fix the spelling, do not work around it.
PWA_PLAN_HANDLE_FREE=free
PWA_PLAN_HANDLE_MONTHLY=pro-monthly
PWA_PLAN_HANDLE_ANNUAL=pro-annual

# Optional, and worth setting. Without these the app records the plan Shopify
# named on its redirect and cannot re-check it — so a cancellation made from
# the merchant's Apps and sales channels settings is never seen, and a merchant
# who edits the redirect URL can grant themselves the paid tier. With them, the
# app calls the Partner API's activeSubscription once an hour per shop and
# corrects the record. See "Billing" in the README.
#
# Org id is in the Partners dashboard URL. The token comes from
# Settings > Partner API clients and needs the "Manage apps" and
# "View financials" permissions. The app id is the numeric id of this app.
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_PARTNER_APP_ID=

# Optional. A Google PageSpeed Insights API key for the Reports page. Without
# one the app uses Google's unauthenticated quota, which is fine for occasional
# runs and starts refusing if you lean on it.
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Enforce Shopify's app proxy signature on the storefront routes.
# Default OFF, deliberately: everything under /apps/pwa/ is a public static
# file that the browser fetches with no session (a <link rel="manifest"> fetch
# is uncredentialed), and a signature mismatch would silently un-install the
# PWA for every visitor. Turn it on only after verifying it passes.
PWA_VERIFY_PROXY=false
