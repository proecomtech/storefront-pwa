{% comment %}
  Pocketfront PWA — app embed block.

  Injects the web app manifest link into <head> on every storefront page, plus
  the small runtime that handles the install card, the Apple meta tags, the iOS
  launch screens and (if enabled) the service worker.

  WHERE THE SETTINGS LIVE
  Almost nothing is configured here. The app name, icon, colours, display mode,
  shortcuts and install card all live in the app's admin, because the manifest
  is generated by the app and a second copy of those values in the theme editor
  would drift from it within a week. This block only decides WHETHER and WHERE
  the PWA loads — which is a theme decision, and belongs in the theme editor.

  The one exception is the theme colour override below, and only because a
  <meta name="theme-color"> has to be in the HTML at first paint to tint the
  address bar before any script runs. Leave it blank and the runtime injects the
  app admin's value, which is right for almost every store.

  WHY AN APP PROXY AND NOT A THEME ASSET
  A manifest's start_url must be same-origin with the manifest itself. A theme
  asset is served from cdn.shopify.com, so start_url "/" would resolve to the
  CDN root and the store would not be installable at all. /apps/pwa/ is on the
  storefront's own domain and survives theme publishing and duplication.
{% endcomment %}

{%- liquid
  assign pwa_base = block.settings.proxy_base | default: '/apps/pwa' | strip
  assign pwa_enabled = true

  # A mistyped proxy path would inject a manifest link that 404s on every page,
  # and a 404 manifest is worse than none: Chrome reports the store as broken
  # rather than simply not installable. So the path must be root-relative, and
  # a trailing slash is trimmed rather than left to produce "//manifest.json".
  assign pwa_first = pwa_base | slice: 0, 1
  if pwa_first != '/'
    assign pwa_enabled = false
  endif

  assign pwa_last = pwa_base | slice: -1, 1
  if pwa_last == '/'
    assign pwa_trim = pwa_base.size | minus: 1
    assign pwa_base = pwa_base | slice: 0, pwa_trim
  endif

  # Optional template exclusions, e.g. "cart,search"
  if block.settings.excluded_templates != blank
    assign pwa_excluded = block.settings.excluded_templates | downcase | split: ','
    for pwa_t in pwa_excluded
      assign pwa_t = pwa_t | strip
      if pwa_t != blank and request.page_type == pwa_t
        assign pwa_enabled = false
      endif
    endfor
  endif
-%}

{%- if pwa_enabled -%}
  {%- comment -%}
    The manifest. Everything else this app does is an enhancement; this one tag
    is what makes the store installable.
  {%- endcomment -%}
  <link rel="manifest" href="{{ pwa_base }}/manifest.json">

  {%- if block.settings.theme_color != blank -%}
    <meta name="theme-color" content="{{ block.settings.theme_color }}">
  {%- endif -%}

  {%- comment -%}
    defer, not async: the runtime touches document.head and document.body, and
    nothing it does needs to happen before first paint. It must not compete with
    the theme for the critical path on a product page.
  {%- endcomment -%}
  <script src="{{ pwa_base }}/pwa.js" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Pocketfront PWA",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "Turning this on is all the theme needs. The app name, icon, colours and install prompt are configured in the app itself — open Apps > Pocketfront PWA."
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "proxy_base",
      "label": "App proxy path",
      "info": "Only change this if you changed the app proxy subpath in the Partner dashboard. Must match it exactly, with no trailing slash.",
      "default": "/apps/pwa"
    },
    {
      "type": "text",
      "id": "theme_color",
      "label": "Theme colour override",
      "info": "Leave blank to use the colour set in the app. Set it only if your theme needs a different address bar colour from the installed app window, e.g. #1a1a1a."
    },
    {
      "type": "text",
      "id": "excluded_templates",
      "label": "Do not load on these templates",
      "info": "Comma separated page types, e.g. cart,search. Leave blank to load everywhere. Excluding a template also means the store cannot be installed from it."
    }
  ]
}
{% endschema %}
